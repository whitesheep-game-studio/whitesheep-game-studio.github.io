{
  "name": "whitesheep-website",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint i18n.js directory.js scripts/**/*.mjs tests/**/*.js *.config.js",
    "format:check": "prettier --check \"*.json\" \"*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \".github/**/*.yml\" \".ci/**/*.yml\" \".ci/*.json\"",
    "html:check": "html-validate \"docs/**/*.html\"",
    "lighthouse": "lhci autorun",
    "i18n:check": "node scripts/export-i18n.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "vitest": "5.0.5"
  },
  "overrides": {
    "lighthouse": "13.6.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "basic-ftp": "6.2.4",
    "chrome-launcher": "1.2.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
